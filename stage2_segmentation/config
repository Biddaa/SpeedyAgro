# =========================
# THRESHOLDS CUSTOMIZATION GUIDE
# =========================
"""
HOW TO CALIBRATE THRESHOLDS:

1. WATER_SAT_THRESH (Step 1 & 2):
   - Default value: 60
   - If too much vegetation classified as water -> INCREASE (70-80)
   - If too much water classified as vegetation -> DECREASE (40-50)
   - Test on 5-10 images with visible water

2. MORPH_KERNEL_SIZE:
   - Default value: 7
   - If too many small artifacts -> INCREASE (9-11)
   - If losing important details -> DECREASE (5-3)

3. PATCH_SIZE (Step 3):
   - Default value: 128
   - For fine details -> DECREASE (64)
   - For higher speed -> INCREASE (256)
   - Note: must match ResNet model input

4. CONFIDENCE_THRESH (Step 3):
   - Default value: 0.7
   - If too many false positives -> INCREASE (0.8-0.9)
   - If too many false negatives -> DECREASE (0.5-0.6)

CALIBRATION WORKFLOW:
1. Select 10 representative images (3 per step)
2. Run with default parameters
3. Visually evaluate results
4. Modify 1 parameter at a time
5. Repeat until satisfactory results
"""





# =========================
# VALIDATION
# =========================
def validate_config():
    """
    Validate configuration for common errors
    """
    errors = []
    
    # Check paths
    if not BASE_DIR.exists():
        errors.append(f"BASE_DIR does not exist: {BASE_DIR}")
    
    # Check altitude ranges
    if STEP1_CONFIG["altitude_min"] >= STEP1_CONFIG["altitude_max"]:
        errors.append("STEP1: altitude_min must be < altitude_max")
    
    if STEP2_CONFIG["altitude_min"] >= STEP2_CONFIG["altitude_max"]:
        errors.append("STEP2: altitude_min must be < altitude_max")
    
    # Check patch size
    if STEP3_CONFIG["patch_size"] % 32 != 0:
        errors.append("STEP3: patch_size should be multiple of 32 for ResNet")
    
    # Check confidence threshold
    if not (0.0 <= STEP3_CONFIG["confidence_thresh"] <= 1.0):
        errors.append("STEP3: confidence_thresh must be between 0.0 and 1.0")
    
    # Check ResNet model
    if STEP3_CONFIG["use_resnet"] and RESNET_MODEL_PATH is not None:
        if not Path(RESNET_MODEL_PATH).exists():
            errors.append(f"ResNet model not found: {RESNET_MODEL_PATH}")
    
    if errors:
        print("WARNING: Configuration errors found:")
        for err in errors:
            print(f"   - {err}")
        return False
    else:
        print("Configuration is valid!")
        return True


