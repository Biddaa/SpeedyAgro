# PIPELINES
# =========================
def analyze_step1(paths, out_subdir="step_1_h80_to_h50"):
    """
    STEP 1: 80-50m - Detect WATER vs VEGETATION
    Output: 1 example image
    """
    out_dir = OUT_DIR / out_subdir
    out_dir.mkdir(parents=True, exist_ok=True)

    rows = []
    example_saved = False

    for p in paths:
        h = parse_height(p)
        if h is None or not (50 <= h <= 80):
            continue

        img = cv2.imread(str(p))
        if img is None:
            continue

        water, field = compute_water_field_masks(img)

        row = {
            "file": p.name,
            "height": h,
            "water_pct": pct(water),
            "field_pct": pct(field),
        }
        rows.append(row)

        # Save ONE example image
        if not example_saved and h == 80:  # use the first at h=80
            overlay = make_overlay_step1(img, water, field)

            fig, axes = plt.subplots(1, 2, figsize=(14, 6))

            axes[0].imshow(cv2.cvtColor(img, cv2.COLOR_BGR2RGB))
            axes[0].set_title("Original (h=80m)", fontsize=14)
            axes[0].axis("off")

            axes[1].imshow(cv2.cvtColor(overlay, cv2.COLOR_BGR2RGB))
            axes[1].set_title("STEP 1: Water vs vegetation Detection", fontsize=14)
            axes[1].axis("off")

            # Add legend
            from matplotlib.patches import Patch

            legend_elements = [
                Patch(facecolor="blue", label="Water"),
                Patch(facecolor="yellow", label="Vegetation"),
            ]
            axes[1].legend(handles=legend_elements, loc="upper right")

            plt.tight_layout()
            plt.savefig(out_dir / "step1_example.png", dpi=150, bbox_inches="tight")
            plt.close()

            example_saved = True

    df = pd.DataFrame(rows).sort_values(["height", "file"]).reset_index(drop=True)
    df.to_csv(out_dir / "summary.csv", index=False)

    print(f"STEP 1 completed: {len(df)} images analyzed")
    return df


