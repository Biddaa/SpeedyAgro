# =========================
# UTILS
# =========================
def parse_height(path: Path):
    """
    Extracts height from filenames like: DJI_0014-h80.JPG or DJI_0014_h80.JPG
    """
    m = re.search(r"[-_ ]h(\d+)", path.stem, flags=re.IGNORECASE)
    return int(m.group(1)) if m else None


def list_images(base_dir: Path):
    return sorted([p for p in base_dir.rglob("*") if p.suffix in IMG_EXT])


# =========================
# STEP 1 & 2: MORPHOLOGY
# =========================
def compute_water_field_masks(img_bgr):
    """
    STEP 1 (80-50m): Detect WATER vs FIELD
    Returns: water_mask, field_mask (boolean)
    """
    hsv = cv2.cvtColor(img_bgr, cv2.COLOR_BGR2HSV)
    H, S, V = cv2.split(hsv)

    # Water = low saturation
    water_mask = (S < WATER_SAT_THRESH)

    # Field = everything else
    field_mask = ~water_mask

    # Morphology cleanup
    k = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (7, 7))
    water_clean = cv2.morphologyEx(
        water_mask.astype(np.uint8) * 255, cv2.MORPH_OPEN, k, iterations=1
    )
    field_clean = cv2.morphologyEx(
        field_mask.astype(np.uint8) * 255, cv2.MORPH_CLOSE, k, iterations=2
    )

    return water_clean > 0, field_clean > 0


def compute_water_veg_masks(img_bgr):
    """
    STEP 2 (60-35m): Detect WATER vs VEGETATION
    Returns: water_mask, veg_mask (boolean)
    """
    hsv = cv2.cvtColor(img_bgr, cv2.COLOR_BGR2HSV)
    H, S, V = cv2.split(hsv)

    # Vegetation (ExG)
    b, g, r = cv2.split(img_bgr.astype(np.float32))
    exg = 2 * g - r - b
    exg_norm = cv2.normalize(exg, None, 0, 255, cv2.NORM_MINMAX).astype(np.uint8)
    _, veg = cv2.threshold(exg_norm, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)

    k = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (7, 7))
    veg = cv2.morphologyEx(veg, cv2.MORPH_OPEN, k, iterations=1)
    veg = cv2.morphologyEx(veg, cv2.MORPH_CLOSE, k, iterations=2)
    veg_mask = veg > 0

    # Water = non-vegetation + low saturation
    water_mask = (~veg_mask) & (S < WATER_SAT_THRESH)

    return water_mask, veg_mask


def pct(mask_bool):
    return float(mask_bool.mean() * 100.0)


def make_overlay_step1(img_bgr, water_mask, field_mask):
    """
    Overlay for STEP 1: water (blue) vs field (brown/yellow)
    """
    overlay = (img_bgr.copy() * 0.4).astype(np.uint8)

    overlay[field_mask] = (100, 200, 200)  # yellow/brown for field (BGR)
    overlay[water_mask] = (200, 100, 0)    # blue-ish for water (BGR)

    out = cv2.addWeighted(img_bgr, 0.5, overlay, 0.5, 0)
    return out


def make_overlay_step2(img_bgr, water_mask, veg_mask):
    """
    Overlay for STEP 2: water (blue) vs vegetation (green)
    """
    overlay = (img_bgr.copy() * 0.4).astype(np.uint8)

    overlay[veg_mask] = (0, 200, 0)       # green for vegetation (BGR)
    overlay[water_mask] = (200, 100, 0)   # blue-ish for water (BGR)

    out = cv2.addWeighted(img_bgr, 0.5, overlay, 0.5, 0)
    return out


