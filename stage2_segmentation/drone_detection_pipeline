def load_resnet_model():
    """
    Loads a pre-trained ResNet50 or a custom model for tree/field classification.
    Placeholder for now - replace with your fine-tuned model.
    """
    from tensorflow.keras.applications import ResNet50
    from tensorflow.keras.models import Model
    from tensorflow.keras.layers import Dense, GlobalAveragePooling2D

    base_model = ResNet50(
        weights="imagenet", include_top=False, input_shape=(PATCH_SIZE, PATCH_SIZE, 3)
    )
    x = base_model.output
    x = GlobalAveragePooling2D()(x)
    x = Dense(256, activation="relu")(x)
    predictions = Dense(4, activation="softmax")(x)  # Vegetation, Water, Soil, Anomaly

    model = Model(inputs=base_model.input, outputs=predictions)
    return model


def extract_patches(img, patch_size=PATCH_SIZE):
    """
    Extracts patches from the image.
    """
    patches = []
    h, w = img.shape[:2]

    for y in range(0, h - patch_size, patch_size):
        for x in range(0, w - patch_size, patch_size):
            patch = img[y : y + patch_size, x : x + patch_size]
            patches.append(patch)

    return np.array(patches)


def classify_patch_simple(patch):
    """
    Simple morphology-based classification for tree vs field.
    (Placeholder - replace with ResNet once you have a trained model.)
    """
    hsv = cv2.cvtColor(patch, cv2.COLOR_BGR2HSV)
    h, s, v = cv2.split(hsv)

    # Water
    if np.mean(s) < WATER_SAT_THRESH:
        return "Water"

    # Vegetation
    b, g, r = cv2.split(patch.astype(np.float32))
    exg = 2 * g - r - b
    if np.mean(exg) > 10:
        # Distinguish tree vs field based on texture/density
        # Tree = denser, field = more uniform
        texture = np.std(v)
        if texture > 40:  # high variation = tree
            return "Tree"
        else:
            return "Field"

    # Soil
    return "Soil"


def make_patch_overlay(img, patch_size=PATCH_SIZE):
    """
    Creates an overlay like the example image with patch-level classification.
    """
    h, w = img.shape[:2]
    overlay = np.zeros_like(img)

    colors = {
        "Field": [0, 255, 0],      # Green (BGR)
        "Water": [255, 0, 0],      # Blue (BGR)
        "Soil": [0, 255, 255],     # Yellow (BGR)
        "Tree": [255, 165, 0],     # Orange (BGR)
        "Anomaly": [0, 0, 255],    # Red (BGR)
    }

    for y in range(0, h - patch_size, patch_size):
        for x in range(0, w - patch_size, patch_size):
            patch = img[y : y + patch_size, x : x + patch_size]
            label = classify_patch_simple(patch)

            # Fill the square with the corresponding color
            overlay[y : y + patch_size, x : x + patch_size] = colors[label]

    return overlay


